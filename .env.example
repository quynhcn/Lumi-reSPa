# ── Cơ sở dữ liệu (bắt buộc) ─────────────────────────────────────────────
# User cần là chủ database (hoặc có quyền CREATE trên database) để chạy migration lần đầu.
DATABASE_URL=postgres://spaflow:matkhau@db-host:5432/spaflow
# require = bật TLS (đa số managed DB yêu cầu). Để trống nếu DB nội bộ không dùng TLS.
DATABASE_SSL=require
# false = chấp nhận chứng chỉ tự ký / CA riêng của nhà cung cấp
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5

# ── Phiên đăng nhập / bảo mật ────────────────────────────────────────────
SESSION_DAYS=30
# Số reverse proxy đứng trước app (để lấy IP thật từ X-Forwarded-For). 0 = không có proxy.
TRUST_PROXY=1
# Các origin khác được phép gọi API (ngoài chính domain của app), cách nhau dấu phẩy. Thường để trống.
ALLOWED_ORIGINS=
# Chuỗi bí mật ngẫu nhiên, dùng khi băm mã OTP (đặt 1 lần, đừng đổi khi đang có OTP chưa dùng)
OTP_PEPPER=
# Bí mật cho các job định kỳ (/api/cron/cleanup, /api/reminders/send). Sinh bằng: openssl rand -hex 32
CRON_SECRET=
# true = bắt buộc xác nhận email trước khi đăng nhập (hiện app CHƯA gửi email xác nhận → để false)
REQUIRE_EMAIL_CONFIRMATION=false

# ── SMS (OTP đặt lịch không cần tài khoản + nhắc lịch) ────────────────────
# webhook | console | (trống = tắt SMS)
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_BRANDNAME=
# Chỉ cho môi trường thử nghiệm: số nhận mã cố định, không gửi SMS. Để TRỐNG trên production.
SMS_TEST_OTP=

# ── Web ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://spaflow.vn
# Google Analytics 4 (tuỳ chọn)
NEXT_PUBLIC_GA_ID=
# Link "Viết đánh giá" Google Maps (tuỳ chọn)
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# ── Chỉ dùng khi chuyển dữ liệu từ Supabase (npm run db:import-supabase) ─
SUPABASE_DB_URL=
